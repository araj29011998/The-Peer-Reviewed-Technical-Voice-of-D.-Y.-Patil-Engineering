# GEMINI_API_KEY: Optional for AI Studio assistance
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

# --- SUPABASE CONFIGURATION ---
# Found in your Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-jwt-key"

# Secret service role key (NEVER expose in client-side bundles; used only in protected server scripts / migrations)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- INSTITUTION & GOVERNANCE CONFIGURATION ---
VITE_INSTITUTION_NAME="D. Y. Patil College of Engineering & Technology"
VITE_PLATFORM_NAME="DY Patil TechVerse"
# Comma-separated list of pre-approved academic email domains for instant institutional email validation
VITE_ALLOWED_EMAIL_DOMAINS="dypatil.edu,dypatilpune.edu,dypatilkolhapur.edu,dypiemr.ac.in,dypvp.edu.in"
# Minimum required character count for technical article submissions
VITE_MIN_ARTICLE_WORDS="300"
